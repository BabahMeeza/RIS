# =========================================================
#  RIS RSUD HANAU - konfigurasi
#  Salin menjadi .env lalu sesuaikan.
# =========================================================
TZ=Asia/Jakarta
HOSPITAL_NAME=RSUD HANAU
HOSPITAL_ADDRESS=Kabupaten Seruyan, Kalimantan Tengah
HOSPITAL_CODE=RSUDHANAU          # Issuer of Patient ID (DICOM) & HL7 facility

# ---- Web / API ----
HTTP_PORT=8090
JWT_SECRET=ganti-dengan-string-acak-panjang
# local  = akun di tabel ris_users
# khanza = cek user/password ke tabel `user` Khanza (AES), role diambil dari ris_users
AUTH_MODE=local

# ---- Database RIS ----
RIS_DB_HOST=127.0.0.1
RIS_DB_PORT=3306
RIS_DB_USER=root
RIS_DB_PASS=
RIS_DB_NAME=ris_hanau

# ---- Database SIMRS Khanza (sik) ----
KHANZA_DB_HOST=192.168.10.4
KHANZA_DB_PORT=3306
KHANZA_DB_USER=sik2020x        # buat user khusus, lihat README (hak akses minimal)
KHANZA_DB_PASS=sik
KHANZA_DB_NAME=sik2020x


# Cara order masuk dari Khanza
#   manual = hanya saat petugas menekan tombol "Kirim ke RIS" di Khanza (POST /api/khanza/order)
#   auto   = RIS menarik permintaan_radiologi tiap SYNC_INTERVAL_MS
SYNC_MODE=manual
KHANZA_API_KEY=Cocot88   # sama dengan RIS_KEY di setting/ris.properties Khanza
KHANZA_API_ALLOW=                # IP PC/server Khanza yang boleh mengirim, pisah koma (kosong = semua)
SYNC_INTERVAL_MS=15000           # hanya untuk SYNC_MODE=auto
SYNC_LOOKBACK_DAYS=2
ACCESSION_FORMAT=khanza          # khanza = noorder tanpa "PR" + kd_jenis_prw, tanpa titik/strip (20261102001BHP02)
                                 # ris    = ACCESSION_PREFIX + yymmdd + nomor urut
ACCESSION_PREFIX=HN              # hanya untuk ACCESSION_FORMAT=ris (maks 16 karakter)


# Tulis balik ke Khanza
KHANZA_WRITE_SAMPEL=true         # isi tgl_sampel/jam_sampel saat pemeriksaan mulai (MPPS)
KHANZA_WRITE_HASIL=false          # tulis hasil_radiologi + tgl_hasil saat expertise diverifikasi   (expertise diisi di Khanza)
KHANZA_WRITE_PERIKSA=false       # buat baris periksa_radiologi (TARIF/BILLING) jika belum ada. Hati-hati!
KHANZA_DEFAULT_NIP=-             # nip petugas default untuk periksa_radiologi
KHANZA_WRITE_GAMBAR=false        # simpan preview JPG ke folder webapps Khanza + gambar_radiologi
KHANZA_GAMBAR_DIR=/var/www/html/webapps/radiologi/pages/upload
KHANZA_GAMBAR_PREFIX=pages/upload/

# ---- DICOM (Modality Worklist + MPPS SCP) ----
DICOM_ENABLED=true
DICOM_AE_TITLE=RISHANAU
DICOM_PORT=11113
DICOM_ACCEPT_UNKNOWN_AE=true     # true = terima AE yang belum terdaftar di master modalitas
MWL_FILTER_BY_CALLING_AE=true    # alat hanya melihat order untuk AE/modalitasnya sendiri
MWL_DEFAULT_DAYS=1               # jika alat tidak kirim tanggal: hari ini s/d N-1 hari ke belakang
DICOM_NAME_UPPERCASE=true

# ---- HL7 v2 (MLLP) ----
HL7_ENABLED=true
HL7_LISTEN_PORT=2575             # terima ORU^R01 (hasil dari PACS/reporting) & ORM status
HL7_OUT_HOST=                    # kirim ORM^O01 ke PACS/broker (kosongkan jika tidak dipakai)
HL7_OUT_PORT=2576
HL7_SENDING_APP=RIS_HANAU
HL7_RECEIVING_APP=PACS
HL7_VERSION=2.3.1
HL7_ORU_AS_FINAL=false           # true = ORU dengan status F langsung jadi FINAL

# ---- PACS Orthanc ----
ORTHANC_ENABLED=true
ORTHANC_URL=http://192.168.10.107:8042
ORTHANC_USER=yanghack
ORTHANC_PASS=sialselamanya
ORTHANC_POLL_MS=10000
ORTHANC_REPLAY_HISTORY=false     # true = proses semua riwayat /changes saat pertama jalan
VIEWER_URL_TEMPLATE=http://192.168.10.107:8042/ohif/viewer?StudyInstanceUIDs={studyUid}

# ---- SATUSEHAT ----
SATUSEHAT_ENABLED=false
SATUSEHAT_AUTH_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1
SATUSEHAT_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=                # Organization ID (IHS) RSUD Hanau
SATUSEHAT_AUTO=true              # kirim otomatis ServiceRequest / DiagnosticReport
SATUSEHAT_INTERVAL_MS=60000
SATUSEHAT_ROUTER_MODALITY=       # nama modality DICOM Router di konfigurasi Orthanc (mis. SATUSEHAT)

DICOM_DUMP_DIR=logs/mwl          # diagnosa query alat (boleh dikosongkan setelah selesai)
